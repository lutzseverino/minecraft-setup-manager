{
  "name": "minecraft-setup-manager",
  "private": true,
  "version": "0.1.4",
  "packageManager": "npm@11.6.2",
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "check:architecture": "depcruise --config dependency-cruiser.cjs src",
    "check:docs": "node scripts/check-docs.mjs",
    "check:updater-config": "node scripts/check-updater-config.mjs --allow-placeholder",
    "check:updater-config:release": "node scripts/check-updater-config.mjs",
    "check:version": "node scripts/check-release-version.mjs",
    "dev": "vite",
    "set:updater-public-key": "node scripts/set-updater-public-key.mjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "test:frontend": "vitest run",
    "test:scripts": "node --test scripts/*.test.mjs",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@tauri-apps/api": "^2.9.0",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@vitejs/plugin-react": "^6.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^26.3.1",
    "lucide-react": "^1.18.0",
    "radix-ui": "^1.6.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.8",
    "shadcn": "^4.11.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "vite": "^8.0.16"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.9.4",
    "@testing-library/react": "^16.3.2",
    "@threema/wasm-minisign-verify": "^0.2.0-rc.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "dependency-cruiser": "^17.3.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
