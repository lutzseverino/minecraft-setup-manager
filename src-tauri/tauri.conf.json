{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Minecraft Setup Manager",
  "mainBinaryName": "Minecraft Setup Manager",
  "version": "0.1.0",
  "identifier": "dev.lutzseverino.minecraft-setup-manager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Minecraft Setup Manager",
        "width": 1120,
        "height": 760,
        "minWidth": 900,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "macOS": {
      "bundleName": "Minecraft Setup Manager"
    },
    "targets": "all"
  }
}
